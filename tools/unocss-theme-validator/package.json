{
	"name": "@wrikka/unocss-theme-validator",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Validate JSX/TSX class names against UnoCSS theme colors",
	"bin": {
		"unocss-theme-validator": "./src/cli.ts"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./vite": {
			"import": "./src/vite.ts",
			"types": "./src/vite.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check src",
		"format": "biome format --write src"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"typescript": "catalog:",
		"unocss": "^66.8.1",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"vite": "catalog:"
	}
}
