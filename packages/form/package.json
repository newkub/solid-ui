{
	"name": "@wrikka/form",
	"version": "0.0.0",
	"private": true,
	"description": "Form primitives and validation helpers for Solid UI",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"dev": "bunx tsdown --watch",
		"build": "bunx tsdown",
		"typecheck": "bunx tsc --noEmit",
		"lint": "biome check src",
		"format": "biome format --write src",
		"test": "vitest run",
		"scan": "ast-grep scan",
		"verify": "bun run scan && bun run lint && bun run typecheck && bun run test",
		"ci": "bun run verify && bun run build"
	},
	"dependencies": {
		"arktype": "catalog:",
		"solid-js": "catalog:"
	},
	"devDependencies": {
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/newkub/solid-ui",
		"directory": "packages/form"
	}
}
