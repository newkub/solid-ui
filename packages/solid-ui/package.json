{
	"name": "@wrikka/solid-ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"description": "Solid UI component library — comprehensive, accessible, and production-ready",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./dist/index.d.ts"
		},
		"./registry": {
			"import": "./src/registry.ts",
			"types": "./src/registry.ts"
		},
		"./styles/*": {
			"import": "./src/styles/*"
		}
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src",
		"format": "biome format --write src",
		"test": "vitest run"
	},
	"dependencies": {
		"@tanstack/solid-table": "^9.2.4",
		"@wrikka/form": "workspace:*",
		"@wrikka/image": "workspace:*",
		"@wrikka/table": "workspace:*",
		"@wrikka/transitions": "workspace:*",
		"arktype": "catalog:",
		"solid-js": "catalog:"
	},
	"devDependencies": {
		"@solidjs/testing-library": "^0.8.10",
		"@vitest/coverage-v8": "3.2.7",
		"jsdom": "^30.0.1",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite-plugin-solid": "^2.11.14",
		"vitest": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/newkub/solid-ui",
		"directory": "packages/solid-ui"
	}
}
