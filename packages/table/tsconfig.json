{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"paths": {
			"#table": ["./src/modules/table"],
			"#table/*": ["./src/modules/table/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
