{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		"baseUrl": ".",
		"paths": {
			"#form/*": ["packages/form/src/*"],
			"#image/*": ["packages/image/src/*"],
			"#table/*": ["packages/table/src/modules/table/*"],
			"#transitions/*": ["packages/transitions/src/*"],
			"@wrikka/form": ["packages/form/src"],
			"@wrikka/image": ["packages/image/src"],
			"@wrikka/table": ["packages/table/src"],
			"@wrikka/transitions": ["packages/transitions/src"],
			"@wrikka/solid-ui": ["packages/solid-ui/src"],
			"@wrikka/solid-ui/*": ["packages/solid-ui/src/*"]
		}
	},
	"include": ["apps/website/src", "packages/solid-ui/src"]
}
