{
	"name": "solid-ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Solid UI demo and packages for wrikka",
	"packageManager": "bun@1.3.14",
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"arktype": "^2.2.3",
			"solid-js": "^1.9.15",
			"tsdown": "^0.22.14",
			"typescript": "^5.6.0"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"typecheck:packages": "bun --filter '@wrikka/*' run typecheck",
		"lint": "biome check src packages",
		"format": "biome format --write src packages",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"solid-js": "catalog:",
		"arktype": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"typescript": "catalog:",
		"tsdown": "catalog:",
		"vite": "^8.2.2",
		"vite-plugin-solid": "^2.11.14",
		"wrangler": "^4.127.1"
	}
}