{
	"name": "solid-ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Solid UI monorepo: design system, website, mcp, cli, and skills",
	"packageManager": "bun@1.3.14",
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*",
			"tools/*"
		],
		"catalog": {
			"arktype": "^2.2.3",
			"solid-js": "^1.9.15",
			"tsdown": "^0.22.14",
			"typescript": "^5.6.0",
			"vite": "^8.2.2"
		}
	},
	"scripts": {
		"dev": "bun run --filter @wrikka/website dev",
		"build": "bun run --filter @wrikka/website build",
		"typecheck": "cross-env NODE_OPTIONS='--max-old-space-size=4096' bun run --filter '*' typecheck",
		"lint": "biome check packages apps tools",
		"format": "biome format --write packages apps tools",
		"review-codebase": "bun run tools/review-codebase/src/cli.ts",
		"review-codebase:json": "bun run tools/review-codebase/src/cli.ts --json",
		"unocss-theme-validator": "bun run tools/unocss-theme-validator/src/cli.ts --config apps/website/uno.config.ts --include 'apps/website/src/**/*.tsx,packages/solid-ui/src/**/*.tsx'",
		"deploy": "bun run --filter @wrikka/website deploy",
		"cf-typegen": "bun run --filter @wrikka/website cf-typegen"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"cross-env": "^7.0.3",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"unrun": "^0.3.1"
	}
}
