		not $darkProps <: contains CssGenericProperty(name=`--color-secondary-foreground`),
		register_diagnostic(span=$dark, message="Missing `--color-secondary-foreground` in .dark", severity="error")
	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-secondary-hover`),
		register_diagnostic(span=$root, message="Missing `--color-secondary-hover` in :root", severity="error")
	},
	`html[data-theme="dark"], .dark { $darkProps }` as $dark where {
		not $darkProps <: contains CssGenericProperty(name=`--color-secondary-hover`),
		register_diagnostic(span=$dark, message="Missing `--color-secondary-hover` in .dark", severity="error")
	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-skeleton`),
		register_diagnostic(span=$root, message="Missing `--color-skeleton` in :root", severity="error")
	},
	`html[data-theme="dark"], .dark { $darkProps }` as $dark where {
		not $darkProps <: contains CssGenericProperty(name=`--color-skeleton`),
		register_diagnostic(span=$dark, message="Missing `--color-skeleton` in .dark", severity="error")
	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-skeleton-shine`),
		register_diagnostic(span=$root, message="Missing `--color-skeleton-shine` in :root", severity="error")
	},
	`html[data-theme="dark"], .dark { $darkProps }` as $dark where {
		not $darkProps <: contains CssGenericProperty(name=`--color-skeleton-shine`),
