	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-overlay`),
		register_diagnostic(span=$root, message="Missing `--color-overlay` in :root", severity="error")
	},
	`html[data-theme="dark"], .dark { $darkProps }` as $dark where {
		not $darkProps <: contains CssGenericProperty(name=`--color-overlay`),
		register_diagnostic(span=$dark, message="Missing `--color-overlay` in .dark", severity="error")
	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-primary`),
		register_diagnostic(span=$root, message="Missing `--color-primary` in :root", severity="error")
	},
	`html[data-theme="dark"], .dark { $darkProps }` as $dark where {
		not $darkProps <: contains CssGenericProperty(name=`--color-primary`),
		register_diagnostic(span=$dark, message="Missing `--color-primary` in .dark", severity="error")
	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-primary-active`),
