engine biome(1.0)
language css

or {
	CssGenericProperty(name=`--color-$name`, value=$value) as $decl where {
		not $value <: r"^\s*\d+(\.\d+)?\s+\d+%\s+\d+%\s*$",
		register_diagnostic(span=$decl, message="Theme color --color-$name must use HSL format: `hue saturation% lightness%`", severity="error")
	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-accent`),
		register_diagnostic(span=$root, message="Missing `--color-accent` in :root", severity="error")
	},
	`html[data-theme="dark"], .dark { $darkProps }` as $dark where {
		not $darkProps <: contains CssGenericProperty(name=`--color-accent`),
		register_diagnostic(span=$dark, message="Missing `--color-accent` in .dark", severity="error")
	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-accent-active`),
		register_diagnostic(span=$root, message="Missing `--color-accent-active` in :root", severity="error")
	},
	`html[data-theme="dark"], .dark { $darkProps }` as $dark where {
		not $darkProps <: contains CssGenericProperty(name=`--color-accent-active`),
		register_diagnostic(span=$dark, message="Missing `--color-accent-active` in .dark", severity="error")
	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-accent-foreground`),
		register_diagnostic(span=$root, message="Missing `--color-accent-foreground` in :root", severity="error")
	},
	`html[data-theme="dark"], .dark { $darkProps }` as $dark where {
		not $darkProps <: contains CssGenericProperty(name=`--color-accent-foreground`),
		register_diagnostic(span=$dark, message="Missing `--color-accent-foreground` in .dark", severity="error")
	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-accent-hover`),
		register_diagnostic(span=$root, message="Missing `--color-accent-hover` in :root", severity="error")
	},
	`html[data-theme="dark"], .dark { $darkProps }` as $dark where {
		not $darkProps <: contains CssGenericProperty(name=`--color-accent-hover`),
		register_diagnostic(span=$dark, message="Missing `--color-accent-hover` in .dark", severity="error")
	},
	`:root { $rootProps }` as $root where {
		not $rootProps <: contains CssGenericProperty(name=`--color-background`),
		register_diagnostic(span=$root, message="Missing `--color-background` in :root", severity="error")
	},
	`html[data-theme="dark"], .dark { $darkProps }` as $dark where {
		not $darkProps <: contains CssGenericProperty(name=`--color-background`),
