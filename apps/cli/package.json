{
	"name": "@wrikka/cli",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "CLI for solid-ui component library",
	"bin": {
		"solid-ui": "./src/index.ts"
	},
	"scripts": {
		"dev": "bun src/index.ts",
		"start": "bun src/index.ts",
		"typecheck": "bunx tsc --noEmit",
		"lint": "biome check src",
		"format": "biome format --write src"
	},
	"dependencies": {
		"@wrikka/solid-ui": "workspace:*",
		"cac": "^6.7.14"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"typescript": "catalog:"
	}
}
